{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["lhr1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@siteflow-supabase-url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@siteflow-supabase-anon-key",
    "SUPABASE_SERVICE_ROLE_KEY": "@siteflow-supabase-service-key",
    "TWILIO_ACCOUNT_SID": "@siteflow-twilio-sid",
    "TWILIO_AUTH_TOKEN": "@siteflow-twilio-token",
    "TWILIO_PHONE_NUMBER": "@siteflow-twilio-phone"
  }
}
